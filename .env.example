# Supabase प्रोजेक्ट की जानकारी (Supabase Dashboard > Project Settings > API से लें)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Razorpay (ऑनलाइन भुगतान / UPI के लिए) - Razorpay Dashboard > Settings > API Keys से लें
